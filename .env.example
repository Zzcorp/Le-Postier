# =============================================================================
# Le Postier — variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (il est dans .gitignore).
# =============================================================================

# --- Coeur -------------------------------------------------------------------

# OBLIGATOIRE. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Attention : changer la clé invalide toutes les sessions et les codes de
# vérification en attente.
SECRET_KEY=

# False en production, True uniquement en développement local.
DEBUG=False

# Noms d'hôte acceptés, séparés par des virgules.
# Production : collections.samathey.fr,127.0.0.1
#   (127.0.0.1 est nécessaire au healthcheck interne du conteneur web)
# Local      : localhost,127.0.0.1
ALLOWED_HOSTS=collections.samathey.fr,127.0.0.1

# URL de base du site (sans slash final) — sitemap, robots.txt, liens absolus
# dans les emails.
SITE_URL=https://collections.samathey.fr

# Origines de confiance pour le CSRF (schéma inclus), séparées par des virgules.
CSRF_TRUSTED_ORIGINS=https://collections.samathey.fr

# --- Base de données ---------------------------------------------------------

# Vide → SQLite local (db.sqlite3).
# Production (docker-compose) :
#   postgres://lepostier:<POSTGRES_PASSWORD>@db:5432/lepostier
DATABASE_URL=

# Utilisées par le service `db` de docker-compose (Postgres 16) :
POSTGRES_DB=lepostier
POSTGRES_USER=lepostier
POSTGRES_PASSWORD=

# --- Médias ------------------------------------------------------------------

# Racine des fichiers médias. Vide → <projet>/media (développement local).
# Production (conteneur web) : /data/media
MEDIA_ROOT=

# --- Email (SMTP Hostinger) --------------------------------------------------

# En local, décommenter pour afficher les emails dans la console :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@collection-samathey.com
# OBLIGATOIRE en production — jamais de valeur par défaut dans le code.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Le Postier <no-reply@collection-samathey.com>
SERVER_EMAIL=no-reply@collection-samathey.com

# Destinataires du formulaire de contact et des notifications, séparés par
# des virgules.
ADMIN_EMAILS=sam@samathey.com,s.mathey@z-data.fr

# --- Gunicorn (conteneur web) ------------------------------------------------

# Nombre de workers gunicorn. Vide → calculé automatiquement (2 × CPU + 1).
WEB_CONCURRENCY=

# --- Divers ------------------------------------------------------------------

# HSTS en secondes. 3600 au départ ; passer à 31536000 une fois le HTTPS
# validé en production (voir DEPLOY_OVH.md).
SECURE_HSTS_SECONDS=3600
